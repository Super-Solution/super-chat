{
  "name": "@supersolutions/super-chat-router",
  "version": "0.1.0",
  "description": "Super Router binding for super-chat: an HTTP InferenceGateway and a text Provider that routes through any InferenceGateway.",
  "license": "Apache-2.0",
  "author": "SUPER SOLUTION LABS INC",
  "homepage": "https://github.com/Super-Solution/super-chat/tree/main/packages/integrations/router#readme",
  "bugs": {
    "url": "https://github.com/Super-Solution/super-chat/issues"
  },
  "keywords": [
    "agent",
    "chat",
    "router",
    "gateway",
    "billing"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-chat.git",
    "directory": "packages/integrations/router"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supersolutions/super-chat-core": "workspace:*",
    "@supersolutions/super-protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
