{
  "name": "@supersolutions/super-chat-ui-core",
  "version": "0.1.0",
  "description": "Framework-free helpers shared by superchat UI bindings: markdown rendering (incl. streaming), value formatting and thread export.",
  "license": "Apache-2.0",
  "author": "SUPER SOLUTION LABS INC",
  "homepage": "https://github.com/Super-Solution/super-chat/tree/main/packages/ui-core#readme",
  "bugs": { "url": "https://github.com/Super-Solution/super-chat/issues" },
  "keywords": ["agent", "llm", "ai", "markdown", "formatting", "export", "ui", "framework-agnostic"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-chat.git",
    "directory": "packages/ui-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supersolutions/super-chat-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
