{
  "name": "@super-solution/super-chat-react",
  "version": "0.5.0",
  "description": "React bindings for superchat: thread state, run control, card actions, and context inspection.",
  "license": "Apache-2.0",
  "author": "ZzyzxLabs",
  "homepage": "https://github.com/Super-Solution/super-chat/tree/main/packages/react#readme",
