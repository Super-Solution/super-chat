{
  "name": "@supersolutions/super-chat-client",
  "version": "0.1.0",
  "description": "Framework-agnostic client for superchat: one AgentClient store per thread that drives the agent runtime. No UI framework dependency.",
  "license": "Apache-2.0",
  "author": "SUPER SOLUTION LABS INC",
  "homepage": "https://github.com/Super-Solution/super-chat/tree/main/packages/client#readme",
  "bugs": { "url": "https://github.com/Super-Solution/super-chat/issues" },
  "keywords": ["agent", "llm", "ai", "chat", "streaming", "store", "framework-agnostic"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-chat.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supersolutions/super-chat-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
