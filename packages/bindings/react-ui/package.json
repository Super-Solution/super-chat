{
  "name": "@supersolutions/super-chat-ui",
  "version": "0.1.0",
  "description": "Card renderers and chat primitives for superchat. Bring your own styling; ships a self-contained CSS baseline.",
  "license": "Apache-2.0",
  "author": "SUPER SOLUTION LABS INC",
  "homepage": "https://github.com/Super-Solution/super-chat/tree/main/packages/bindings/react-ui#readme",
  "bugs": { "url": "https://github.com/Super-Solution/super-chat/issues" },
  "keywords": ["agent", "llm", "ai", "react", "chat-ui", "components", "cards", "framework"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mobile-agent": {
      "types": "./dist/mobile-agent.d.ts",
      "import": "./dist/mobile-agent.js",
      "default": "./dist/mobile-agent.js"
    },
    "./mobile-agent/react-native": {
      "types": "./dist/mobile-agent-react-native.d.ts",
      "import": "./dist/mobile-agent-react-native.js",
      "default": "./dist/mobile-agent-react-native.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css", "MOBILE-AGENT.md", "LICENSE", "NOTICE"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-chat.git",
    "directory": "packages/bindings/react-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@supersolutions/super-chat-client": "workspace:*",
    "@supersolutions/super-chat-core": "workspace:*",
    "@supersolutions/super-chat-ui-core": "workspace:*",
    "@supersolutions/super-chat-react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
