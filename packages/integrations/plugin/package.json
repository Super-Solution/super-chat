{
  "name": "@supersolutions/super-chat-plugin",
  "version": "0.1.0",
  "description": "Plugin host for super-chat: install a super-protocol ChatPlugin into the card registry and render its cards in React.",
  "license": "Apache-2.0",
  "author": "SUPER SOLUTION LABS INC",
  "homepage": "https://github.com/Super-Solution/super-chat/tree/main/packages/integrations/plugin#readme",
  "bugs": {
    "url": "https://github.com/Super-Solution/super-chat/issues"
  },
  "keywords": [
    "agent",
    "chat",
    "plugin",
    "cards"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Solution/super-chat.git",
    "directory": "packages/integrations/plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@supersolutions/super-chat-core": "workspace:*",
    "@supersolutions/super-chat-ui": "workspace:*",
    "@supersolutions/super-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
